<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity
      type="win32"
      name="rust-slint-password-saver"
      version="1.0.0.0"/>

  <!-- DPI awareness: PerMonitorV2 for crisp rendering on all display configurations -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <!-- Legacy dpiAware element for Windows Vista/7/8 compatibility -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <!-- Modern PerMonitorV2 DPI awareness for Windows 10 1703+ -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Long-path support: opt in to paths > 260 characters (MAX_PATH) on Windows 10 1607+.
           Requires HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled = 1. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- Windows compatibility: declare support for Windows 10 and 11 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows Server 2016 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
