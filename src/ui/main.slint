import { Button, VerticalBox, HorizontalBox, LineEdit, TextEdit, ScrollView, GroupBox, CheckBox, Slider } from "std-widgets.slint";

// Color Palette
global Colors {
    // Primary Colors
    out property <color> forest-green: #2d5016;
    out property <color> charcoal: #2c2c2c;
    out property <color> warm-grey: #6b6b6b;
    out property <color> whisper-grey: #e8e8e8;

    // Accent Colors
    out property <color> vermillion: #c1440e;
    out property <color> indigo: #1a365d;
    out property <color> cream: #faf9f6;

    // State Colors
    out property <color> success-bg: #e6f4e7;
    out property <color> success-border: forest-green;
    out property <color> success-text: #1d3010;

    out property <color> error-bg: #ffeaea;
    out property <color> error-border: vermillion;
    out property <color> error-text: #8b1a0a;
    
    out property <color> disabled: #d3d3d3;
}

// Typography System
global Typography {
    // Heading 1 - Screen Title
    out property <length> h1-size: 28px;
    out property <int> h1-weight: 600;
    out property <length> h1-letter-spacing: -0.5px;
    
    // Heading 2 - Section Title
    out property <length> h2-size: 18px;
    out property <int> h2-weight: 600;
    
    // Body Text (Primary)
    out property <length> body-size: 14px;
    out property <int> body-weight: 400;
    
    // Secondary Text
    out property <length> secondary-size: 13px;
    out property <int> secondary-weight: 400;
    
    // Small Text (Tertiary)
    out property <length> small-size: 11px;
    out property <int> small-weight: 400;
    
    // Button Text
    out property <length> button-size: 14px;
    out property <int> button-weight: 500;
}

// Spacing System
global Spacing {
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 20px;
    out property <length> xxl: 24px;
    out property <length> xxxl: 32px;
}

// Primary Button Component
component PrimaryButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    
    forward-focus: focus-scope;
    
    focus-scope := FocusScope {
        key-pressed(event) => {
            if (root.enabled && event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        
        key-released(event) => {
            if (root.enabled && event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    
    Rectangle {
        background: root.enabled ? Colors.forest-green : Colors.disabled;
        border-radius: 4px;
        min-width: 100px;
        height: 36px;
        
        TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        
        Text {
            text: root.text;
            color: root.enabled ? white : #666666;
            font-size: Typography.body-size;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Secondary Button Component
component SecondaryButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    
    forward-focus: focus-scope;
    
    focus-scope := FocusScope {
        key-pressed(event) => {
            if (root.enabled && event.text == Key.Escape) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    
    Rectangle {
        background: transparent;
        border-width: 1px;
        border-color: root.enabled ? Colors.forest-green : #d3d3d3;
        border-radius: 4px;
        min-width: 100px;
        height: 36px;
        
        TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        
        Text {
            text: root.text;
            color: root.enabled ? Colors.forest-green : #999999;
            font-size: Typography.body-size;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Task 2.3: Input Field Styling Limitation
// ===========================================
// LIMITATION: Slint v1.14's standard LineEdit widget does not support custom border properties
// (border-color, border-width, border-radius) as documented in GitHub issue #3173.
//
// The following properties are NOT available on LineEdit:
// - border-color
// - border-width
// - border-radius
//
// CURRENT STATE: All LineEdit components in this application use Slint's default styling, which
// includes built-in focus states and platform-native appearance.
//
// DESIRED STYLING (cannot be applied directly):
// - border-color: #d3d3d3 (Colors.disabled)
// - border-width: 1px
// - border-radius: 4px
//
// WORKAROUND OPTIONS (not implemented due to complexity and usability trade-offs):
// 1. Create custom input component wrapping Rectangle + TextInput (loses LineEdit features)
// 2. Wait for Slint v1.15+ which may add these styling properties (see GitHub issues #3173, #5392)
//
// RECOMMENDATION: Continue using standard LineEdit with default styling until Slint adds
// native support for custom border properties. The default styling provides good usability
// and consistent platform-native appearance.
//
// All 12 LineEdit instances in this file:
// - master-password-input (Initial Setup screen)
// - title-input (Add Password section)
// - username-input (Add Password section)
// - password-input (Add Password section)
// - generated-password-display (Password Generator section)
// - search-input (Search and Filter section)
// - copy-value-input (Copy Password section)
// - current-password-input (Change Master Password dialog)
// - new-password-input (Change Master Password dialog)
// - confirm-password-input (Change Master Password dialog)
// - unlock-password (Lock Screen)
// - recovery-code-input (Recovery Login screen)

// Task 2.4: Custom Card Component (replaces GroupBox)
// ====================================================
// Custom Card component with refined styling for more elegant appearance.
// Replaces standard GroupBox which doesn't support custom styling in Slint v1.14.
//
// Styling specifications:
// - Background: Colors.cream (#faf9f6)
// - Border: 1px solid Colors.whisper-grey (#e8e8e8)
// - Border radius: 6px
// - Padding: Spacing.lg (16px)
// - Title font: 16px, weight 600, color charcoal (#2c2c2c)
component Card inherits Rectangle {
    in property <string> title;
    
    background: Colors.cream;
    border-width: 1px;
    border-color: Colors.whisper-grey;
    border-radius: 6px;
    
    VerticalBox {
        padding: Spacing.lg;
        spacing: Spacing.lg;
        
        if title != "" : Text {
            text: title;
            font-size: 16px;
            font-weight: 600;
            color: Colors.charcoal;
        }
        
        @children
    }
}

export component AppWindow inherits Window {
    title: "Password Saver — Secure Password Manager";
    preferred-width: 600px;
    preferred-height: 700px;  // Increased for more vertical space
    min-width: 500px;
    min-height: 600px;
    
    in-out property <string> status-message: "";
    in-out property <bool> status-is-error: false;
    in-out property <string> master-password: "";
    in-out property <bool> show-change-password-dialog: false;
    in-out property <bool> is-locked: false;
    in-out property <int> seconds-until-lock: 0;
    
    // Recovery properties
    in-out property <bool> show-recovery-setup: false;
    in-out property <bool> show-recovery-login: false;
    in-out property <string> recovery-code-1: "";
    in-out property <string> recovery-code-2: "";
    in-out property <string> recovery-code-3: "";
    in-out property <bool> recovery-codes-confirmed: false;
    
    // Search and filter properties
    in-out property <string> search-query: "";
    in-out property <int> sort-option: 0;
    in-out property <int> filtered-count: 0;
    in-out property <int> total-count: 0;
    
    // Password generator properties
    in-out property <float> generator-length: 16;
    in-out property <bool> generator-use-uppercase: true;
    in-out property <bool> generator-use-lowercase: true;
    in-out property <bool> generator-use-digits: true;
    in-out property <bool> generator-use-special: true;
    in-out property <bool> generator-exclude-ambiguous: true;
    in-out property <string> generated-password: "";
    in-out property <string> password-entropy-text: "";
    
    // Update notification properties
    in-out property <bool> update-available: false;
    in-out property <bool> is-security-update: false;
    in-out property <string> latest-version: "";
    in-out property <string> download-url: "";
    in-out property <bool> checking-for-updates: false;
    
    callback save-password(string, string, string, string);
    callback load-passwords(string);
    callback change-master-password(string, string, string);
    callback unlock(string);
    callback lock-session();
    callback copy-password(string);
    callback generate-password();
    callback use-generated-password(string);
    callback search-passwords(string);
    callback sort-passwords(int);
    callback check-for-updates();
    callback open-release-page();
    callback show-recovery();
    callback recover-with-code(string);
    callback copy-recovery-codes();
    callback print-recovery-codes();
    
    VerticalBox {
        padding: Spacing.xl;
        spacing: Spacing.lg;
        
        Text {
            text: "Password Saver";
            font-size: Typography.h1-size;
            font-weight: Typography.h1-weight;
            letter-spacing: Typography.h1-letter-spacing;
            color: Colors.charcoal;
            horizontal-alignment: left;
        }
        
        // Update notification banner
        if root.update-available : Rectangle {
            background: root.is-security-update ? #ff9800 : #2196f3;
            border-radius: 4px;
            
            HorizontalBox {
                padding: Spacing.md;
                spacing: Spacing.md;
                
                Text {
                    text: root.is-security-update ? 
                        "⚠️ Security Update Available: " + root.latest-version :
                        "ℹ️ New Version Available: " + root.latest-version;
                    color: white;
                    font-size: Typography.body-size;
                    font-weight: Typography.body-weight;
                    vertical-alignment: center;
                }
                
                Button {
                    text: "View Release";
                    clicked => {
                        root.open-release-page();
                    }
                }
                
                Button {
                    text: "Dismiss";
                    clicked => {
                        root.update-available = false;
                    }
                }
            }
        }
        
        Card {
            title: "Master Password";
            
            VerticalBox {
                spacing: Spacing.md;
                
                HorizontalBox {
                    Text {
                        text: "Master Password:";
                        vertical-alignment: center;
                        min-width: 120px;
                    }
                    master-password-input := LineEdit {
                        placeholder-text: "Enter your master password";
                        input-type: password;
                        text <=> root.master-password;
                    }
                }
                
                Text {
                    text: "This password is used to encrypt/decrypt your stored passwords";
                    font-size: Typography.secondary-size;
                    font-weight: Typography.secondary-weight;
                    color: Colors.warm-grey;
                }
            }
        }
        
        Card {
            title: "Add New Password";
            
            VerticalBox {
                spacing: Spacing.md;
                
                HorizontalBox {
                    Text {
                        text: "Title:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    title-input := LineEdit {
                        placeholder-text: "e.g., Gmail, GitHub, etc.";
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Username:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    username-input := LineEdit {
                        placeholder-text: "Username or email";
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Password:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    password-input := LineEdit {
                        placeholder-text: "Enter password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    PrimaryButton {
                        text: "Save Password (Enter)";
                        enabled: root.master-password != "" && title-input.text != "" && password-input.text != "";
                        clicked => {
                            root.save-password(
                                root.master-password,
                                title-input.text,
                                username-input.text,
                                password-input.text
                            );
                            // Clear inputs after saving
                            title-input.text = "";
                            username-input.text = "";
                            password-input.text = "";
                        }
                    }
                    
                    SecondaryButton {
                        text: "Load Passwords";
                        enabled: root.master-password != "";
                        clicked => {
                            root.load-passwords(root.master-password);
                        }
                    }
                    
                    SecondaryButton {
                        text: "Change Master Password";
                        enabled: root.master-password != "";
                        clicked => {
                            root.show-change-password-dialog = true;
                        }
                    }
                    
                    Button {
                        text: "🔄 Check for Updates";
                        enabled: !root.checking-for-updates;
                        clicked => {
                            root.check-for-updates();
                        }
                    }
                }
            }
        }
        
        Card {
            title: "Password Generator";
            
            VerticalBox {
                spacing: Spacing.md;
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    Text {
                        text: "Length:";
                        min-width: 100px;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 8;
                        maximum: 32;
                        value <=> root.generator-length;
                        min-width: 150px;
                    }
                    Text {
                        text: root.generator-length;
                        min-width: 30px;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    CheckBox {
                        text: "Uppercase (A-Z)";
                        checked <=> root.generator-use-uppercase;
                    }
                    CheckBox {
                        text: "Lowercase (a-z)";
                        checked <=> root.generator-use-lowercase;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    CheckBox {
                        text: "Digits (0-9)";
                        checked <=> root.generator-use-digits;
                    }
                    CheckBox {
                        text: "Special (!@#$...)";
                        checked <=> root.generator-use-special;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    CheckBox {
                        text: "Exclude ambiguous (0,O,I,i,l,o,1)";
                        checked <=> root.generator-exclude-ambiguous;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.xs;
                    
                    generated-password-display := LineEdit {
                        placeholder-text: "Generated password will appear here";
                        read-only: true;
                        text <=> root.generated-password;
                        min-width: 250px;
                    }
                    
                    Button {
                        text: "🔄 Generate";
                        clicked => {
                            root.generate-password();
                        }
                    }
                    
                    Button {
                        text: "📋 Copy";
                        enabled: root.generated-password != "";
                        clicked => {
                            root.copy-password(root.generated-password);
                        }
                    }
                    
                    Button {
                        text: "✓ Use";
                        enabled: root.generated-password != "";
                        clicked => {
                            root.use-generated-password(root.generated-password);
                        }
                    }
                }
                
                if root.password-entropy-text != "" : Text {
                    text: root.password-entropy-text;
                    font-size: Typography.secondary-size;
                    font-weight: Typography.secondary-weight;
                    color: Colors.forest-green;
                }
            }
        }
        
        Card {
            title: "Search and Filter Passwords";
            
            VerticalBox {
                spacing: Spacing.md;
                
                HorizontalBox {
                    spacing: Spacing.xs;
                    
                    search-input := LineEdit {
                        placeholder-text: "Search by title or username...";
                        text <=> root.search-query;
                        edited => {
                            root.search-passwords(search-input.text);
                        }
                    }
                    
                    Button {
                        text: "🔍 Search";
                        clicked => {
                            root.search-passwords(search-input.text);
                        }
                    }
                    
                    Button {
                        text: "✕ Clear";
                        enabled: search-input.text != "";
                        clicked => {
                            search-input.text = "";
                            root.search-passwords("");
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.xs;
                    
                    Text {
                        text: "Sort by:";
                        vertical-alignment: center;
                        min-width: 60px;
                    }
                    
                    Button {
                        text: "Title ↑";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(0);
                        }
                    }
                    
                    Button {
                        text: "Title ↓";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(1);
                        }
                    }
                    
                    Button {
                        text: "Newest";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(2);
                        }
                    }
                    
                    Button {
                        text: "Oldest";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(3);
                        }
                    }
                    
                    Button {
                        text: "User";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(4);
                        }
                    }
                }
                
                if root.total-count > 0 : Text {
                    text: "Showing " + root.filtered-count + " of " + root.total-count + " passwords";
                    font-size: Typography.secondary-size;
                    font-weight: Typography.secondary-weight;
                    color: Colors.warm-grey;
                }
            }
        }
        
        Card {
            title: "Copy Password to Clipboard";
            
            VerticalBox {
                spacing: Spacing.md;
                
                HorizontalBox {
                    Text {
                        text: "Password to Copy:";
                        vertical-alignment: center;
                        min-width: 120px;
                    }
                    copy-value-input := LineEdit {
                        placeholder-text: "Enter password value to copy";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    Button {
                        text: "📋 Copy to Clipboard";
                        primary: true;
                        enabled: copy-value-input.text != "";
                        clicked => {
                            root.copy-password(copy-value-input.text);
                            // Don't clear the field immediately so user can copy again if needed
                        }
                    }
                    
                    Button {
                        text: "Clear Field";
                        enabled: copy-value-input.text != "";
                        clicked => {
                            copy-value-input.text = "";
                        }
                    }
                }
                
                Text {
                    text: "Password will be automatically cleared from clipboard after 30 seconds";
                    font-size: Typography.secondary-size;
                    font-weight: Typography.secondary-weight;
                    color: Colors.warm-grey;
                }
            }
        }
        
        Card {
            title: "Stored Passwords";
            
            ScrollView {
                height: 200px;
                
                VerticalBox {
                    alignment: center;
                    spacing: Spacing.lg;
                    
                    Text {
                        text: "🔐";
                        font-size: 48px;
                        horizontal-alignment: center;
                    }
                    
                    Text {
                        text: "No passwords saved yet";
                        font-size: Typography.h2-size;
                        font-weight: 600;
                        color: Colors.charcoal;
                        horizontal-alignment: center;
                    }
                    
                    Text {
                        text: "Add your first password above to get started.";
                        font-size: Typography.secondary-size;
                        color: Colors.warm-grey;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        
        Card {
            title: "⌨️ Keyboard Shortcuts";
            
            VerticalBox {
                spacing: Spacing.sm;
                
                Text {
                    text: "Common Actions:";
                    font-weight: 600;
                    font-size: Typography.body-size;
                    color: Colors.charcoal;
                }
                
                Text {
                    text: "• Enter - Submit form or confirm dialog\n• Esc - Close dialog or cancel action\n• Space - Activate focused button";
                    font-size: Typography.secondary-size;
                    color: Colors.warm-grey;
                }
                
                Text {
                    text: "\nDialog Actions:";
                    font-weight: 600;
                    font-size: Typography.body-size;
                    color: Colors.charcoal;
                }
                
                Text {
                    text: "• Change Password dialog: Enter to submit, Esc to cancel\n• Lock Screen: Enter to unlock\n• Recovery dialogs: Enter to submit, Esc to cancel";
                    font-size: Typography.secondary-size;
                    color: Colors.warm-grey;
                }
            }
        }
        
        if status-message != "" : Rectangle {
            background: status-is-error ? Colors.error-bg : Colors.success-bg;
            border-radius: 4px;
            border-width: 1px;
            border-color: status-is-error ? Colors.error-border : Colors.success-border;
            
            HorizontalBox {
                padding: Spacing.md;
                spacing: Spacing.md;
                
                Text {
                    text: status-is-error ? "⚠" : "✓";
                    font-size: 16px;
                    color: status-is-error ? Colors.error-text : Colors.success-text;
                    vertical-alignment: center;
                }
                
                Text {
                    text: status-message;
                    color: status-is-error ? Colors.error-text : Colors.success-text;
                    font-size: Typography.body-size;
                    vertical-alignment: center;
                }
            }
        }
    }
    
    // Change Master Password Dialog
    if root.show-change-password-dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    // Clear fields and close dialog
                    current-password-input.text = "";
                    new-password-input.text = "";
                    confirm-password-input.text = "";
                    root.show-change-password-dialog = false;
                    return accept;
                }
                return reject;
            }
        }
        
        Rectangle {
            width: 500px;
            background: Colors.cream;
            border-radius: 8px;
            border-width: 1px;
            border-color: Colors.whisper-grey;
            drop-shadow-blur: 40px;
            drop-shadow-color: rgba(0, 0, 0, 0.2);
            
            VerticalBox {
                padding: Spacing.xl;
                spacing: Spacing.lg;
                
                Text {
                    text: "Change Master Password";
                    font-size: 20px;
                    font-weight: 600;
                    color: Colors.charcoal;
                    horizontal-alignment: left;
                }
                
                HorizontalBox {
                    Text {
                        text: "Current Password:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    current-password-input := LineEdit {
                        placeholder-text: "Enter current password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "New Password:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    new-password-input := LineEdit {
                        placeholder-text: "Enter new password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Confirm New:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    confirm-password-input := LineEdit {
                        placeholder-text: "Confirm new password";
                        input-type: password;
                    }
                }
                
                Rectangle {
                    background: #f5f5f5;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Colors.whisper-grey;
                    
                    VerticalBox {
                        padding: Spacing.md;
                        spacing: Spacing.sm;
                        
                        Text {
                            text: "Password Requirements:";
                            font-weight: 600;
                            font-size: Typography.body-size;
                            color: Colors.charcoal;
                        }
                        
                        Text {
                            text: "• At least 8 characters long\n• At least one uppercase letter\n• At least one lowercase letter\n• At least one number";
                            font-size: Typography.secondary-size;
                            color: Colors.warm-grey;
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    alignment: end;
                    
                    SecondaryButton {
                        text: "Cancel (Esc)";
                        clicked => {
                            // Clear fields and close dialog
                            current-password-input.text = "";
                            new-password-input.text = "";
                            confirm-password-input.text = "";
                            root.show-change-password-dialog = false;
                        }
                    }
                    
                    PrimaryButton {
                        text: "Change Password (Enter)";
                        enabled: current-password-input.text != "" && 
                                new-password-input.text != "" && 
                                confirm-password-input.text != "";
                        clicked => {
                            root.change-master-password(
                                current-password-input.text,
                                new-password-input.text,
                                confirm-password-input.text
                            );
                            // Clear fields and close dialog
                            current-password-input.text = "";
                            new-password-input.text = "";
                            confirm-password-input.text = "";
                            root.show-change-password-dialog = false;
                        }
                    }
                }
            }
        }
    }
    
    // Lock screen overlay
    if root.is-locked : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        Rectangle {
            width: 400px;
            height: 300px;
            background: Colors.cream;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: Spacing.xxxl;
                spacing: Spacing.xl;
                
                Text {
                    text: "🔒 Session Locked";
                    font-size: Typography.h1-size;
                    font-weight: Typography.h1-weight;
                    letter-spacing: Typography.h1-letter-spacing;
                    color: Colors.charcoal;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Enter master password to unlock";
                    horizontal-alignment: center;
                    color: Colors.warm-grey;
                }
                
                unlock-password := LineEdit {
                    placeholder-text: "Master password";
                    input-type: password;
                }
                
                PrimaryButton {
                    text: "Unlock (Enter)";
                    enabled: unlock-password.text != "";
                    clicked => {
                        root.unlock(unlock-password.text);
                        unlock-password.text = "";
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    
                    TouchArea {
                        width: 150px;
                        height: 20px;
                        
                        Text {
                            text: "Forgot Password?";
                            color: Colors.indigo;
                            font-size: Typography.secondary-size;
                            font-weight: Typography.secondary-weight;
                            horizontal-alignment: center;
                        }
                        
                        clicked => {
                            root.show-recovery-login = true;
                        }
                    }
                }
            }
        }
    }
    
    // Timer countdown display (when not locked and time is shown)
    if !root.is-locked && root.seconds-until-lock > 0 && root.seconds-until-lock <= 60 : Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 180px;
        height: 30px;
        background: #fff3e0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ff9800;
        
        HorizontalBox {
            padding: Spacing.xs;
            
            Text {
                text: "Auto-lock in: " + root.seconds-until-lock + "s";
                color: #e65100;
                font-size: Typography.secondary-size;
                font-weight: Typography.secondary-weight;
                vertical-alignment: center;
            }
        }
    }
    
    // Recovery setup dialog (first-time setup)
    if root.show-recovery-setup : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape && root.recovery-codes-confirmed) {
                    root.show-recovery-setup = false;
                    root.recovery-codes-confirmed = false;
                    return accept;
                }
                return reject;
            }
        }
        
        Rectangle {
            width: 550px;
            height: 500px;
            background: Colors.cream;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: Spacing.xxxl;
                spacing: Spacing.lg;
                
                Text {
                    text: "⚠️ Important: Save Your Recovery Codes";
                    font-size: Typography.h2-size;
                    font-weight: Typography.h2-weight;
                    color: Colors.charcoal;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Write down these recovery codes and store them securely.\nYou will need them if you forget your master password.";
                    horizontal-alignment: center;
                    color: Colors.warm-grey;
                }
                
                Rectangle {
                    background: Colors.whisper-grey;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #ddd;
                    
                    VerticalBox {
                        padding: Spacing.xl;
                        spacing: Spacing.md;
                        
                        Text {
                            text: "Recovery Code 1: " + root.recovery-code-1;
                            font-family: "monospace";
                            font-size: Typography.body-size;
                            font-weight: Typography.body-weight;
                        }
                        Text {
                            text: "Recovery Code 2: " + root.recovery-code-2;
                            font-family: "monospace";
                            font-size: Typography.body-size;
                            font-weight: Typography.body-weight;
                        }
                        Text {
                            text: "Recovery Code 3: " + root.recovery-code-3;
                            font-family: "monospace";
                            font-size: Typography.body-size;
                            font-weight: Typography.body-weight;
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    alignment: center;
                    
                    Button {
                        text: "📋 Copy All Codes";
                        clicked => {
                            root.copy-recovery-codes();
                        }
                    }
                    
                    Button {
                        text: "🖨️ Print Codes";
                        clicked => {
                            root.print-recovery-codes();
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    
                    CheckBox {
                        text: "I have saved my recovery codes in a secure location";
                        checked <=> root.recovery-codes-confirmed;
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    
                    PrimaryButton {
                        text: "Continue (Enter)";
                        enabled: root.recovery-codes-confirmed;
                        clicked => {
                            root.show-recovery-setup = false;
                            root.recovery-codes-confirmed = false;
                        }
                    }
                }
                
                Text {
                    text: "Press Esc to close";
                    horizontal-alignment: center;
                    font-size: Typography.small-size;
                    color: Colors.warm-grey;
                }
            }
        }
    }
    
    // Recovery login dialog
    if root.show-recovery-login : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.show-recovery-login = false;
                    recovery-code-input.text = "";
                    return accept;
                }
                return reject;
            }
        }
        
        Rectangle {
            width: 450px;
            height: 350px;
            background: Colors.cream;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: Spacing.xxxl;
                spacing: Spacing.xl;
                
                Text {
                    text: "🔑 Emergency Recovery";
                    font-size: Typography.h1-size;
                    font-weight: Typography.h1-weight;
                    letter-spacing: Typography.h1-letter-spacing;
                    color: Colors.charcoal;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Enter one of your recovery codes to regain access:";
                    horizontal-alignment: center;
                    color: Colors.warm-grey;
                }
                
                recovery-code-input := LineEdit {
                    placeholder-text: "XXXX-XXXX-XXXX-XXXX";
                }
                
                HorizontalBox {
                    spacing: Spacing.md;
                    alignment: center;
                    
                    PrimaryButton {
                        text: "Recover Access (Enter)";
                        enabled: recovery-code-input.text != "";
                        clicked => {
                            root.recover-with-code(recovery-code-input.text);
                            recovery-code-input.text = "";
                        }
                    }
                    
                    SecondaryButton {
                        text: "Cancel (Esc)";
                        clicked => {
                            root.show-recovery-login = false;
                            recovery-code-input.text = "";
                        }
                    }
                }
                
                Text {
                    text: "⚠️ Recovery codes were provided during initial setup.\nContact support if you've lost all recovery codes.";
                    horizontal-alignment: center;
                    font-size: Typography.small-size;
                    font-weight: Typography.small-weight;
                    color: Colors.warm-grey;
                }
            }
        }
    }
}
