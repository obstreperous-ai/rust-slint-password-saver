import { Button, VerticalBox, HorizontalBox, LineEdit, TextEdit, ScrollView, GroupBox, CheckBox, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Password Saver";
    preferred-width: 600px;
    preferred-height: 600px;
    
    in-out property <string> status-message: "";
    in-out property <string> master-password: "";
    in-out property <bool> show-change-password-dialog: false;
    in-out property <bool> is-locked: false;
    in-out property <int> seconds-until-lock: 0;
    
    // Recovery properties
    in-out property <bool> show-recovery-setup: false;
    in-out property <bool> show-recovery-login: false;
    in-out property <string> recovery-code-1: "";
    in-out property <string> recovery-code-2: "";
    in-out property <string> recovery-code-3: "";
    in-out property <bool> recovery-codes-confirmed: false;
    
    // Search and filter properties
    in-out property <string> search-query: "";
    in-out property <int> sort-option: 0;
    in-out property <int> filtered-count: 0;
    in-out property <int> total-count: 0;
    
    // Password generator properties
    in-out property <float> generator-length: 16;
    in-out property <bool> generator-use-uppercase: true;
    in-out property <bool> generator-use-lowercase: true;
    in-out property <bool> generator-use-digits: true;
    in-out property <bool> generator-use-special: true;
    in-out property <bool> generator-exclude-ambiguous: true;
    in-out property <string> generated-password: "";
    in-out property <string> password-entropy-text: "";
    
    // Update notification properties
    in-out property <bool> update-available: false;
    in-out property <bool> is-security-update: false;
    in-out property <string> latest-version: "";
    in-out property <string> download-url: "";
    in-out property <bool> checking-for-updates: false;
    
    callback save-password(string, string, string, string);
    callback load-passwords(string);
    callback change-master-password(string, string, string);
    callback unlock(string);
    callback lock-session();
    callback copy-password(string);
    callback generate-password();
    callback use-generated-password(string);
    callback search-passwords(string);
    callback sort-passwords(int);
    callback check-for-updates();
    callback open-release-page();
    callback show-recovery();
    callback recover-with-code(string);
    callback copy-recovery-codes();
    callback print-recovery-codes();
    
    VerticalBox {
        padding: 20px;
        spacing: 15px;
        
        Text {
            text: "Password Saver";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        
        // Update notification banner
        if root.update-available : Rectangle {
            background: root.is-security-update ? #ff9800 : #2196f3;
            border-radius: 4px;
            
            HorizontalBox {
                padding: 10px;
                spacing: 10px;
                
                Text {
                    text: root.is-security-update ? 
                        "⚠️ Security Update Available: " + root.latest-version :
                        "ℹ️ New Version Available: " + root.latest-version;
                    color: white;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                
                Button {
                    text: "View Release";
                    clicked => {
                        root.open-release-page();
                    }
                }
                
                Button {
                    text: "Dismiss";
                    clicked => {
                        root.update-available = false;
                    }
                }
            }
        }
        
        GroupBox {
            title: "Master Password";
            
            VerticalBox {
                spacing: 10px;
                
                HorizontalBox {
                    Text {
                        text: "Master Password:";
                        vertical-alignment: center;
                        min-width: 120px;
                    }
                    master-password-input := LineEdit {
                        placeholder-text: "Enter your master password";
                        input-type: password;
                        text <=> root.master-password;
                    }
                }
                
                Text {
                    text: "This password is used to encrypt/decrypt your stored passwords";
                    font-size: 12px;
                    color: #666;
                }
            }
        }
        
        GroupBox {
            title: "Add New Password";
            
            VerticalBox {
                spacing: 10px;
                
                HorizontalBox {
                    Text {
                        text: "Title:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    title-input := LineEdit {
                        placeholder-text: "e.g., Gmail, GitHub, etc.";
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Username:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    username-input := LineEdit {
                        placeholder-text: "Username or email";
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Password:";
                        vertical-alignment: center;
                        min-width: 100px;
                    }
                    password-input := LineEdit {
                        placeholder-text: "Enter password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    Button {
                        text: "Save Password";
                        primary: true;
                        enabled: root.master-password != "" && title-input.text != "" && password-input.text != "";
                        clicked => {
                            root.save-password(
                                root.master-password,
                                title-input.text,
                                username-input.text,
                                password-input.text
                            );
                            // Clear inputs after saving
                            title-input.text = "";
                            username-input.text = "";
                            password-input.text = "";
                        }
                    }
                    
                    Button {
                        text: "Load Passwords";
                        enabled: root.master-password != "";
                        clicked => {
                            root.load-passwords(root.master-password);
                        }
                    }
                    
                    Button {
                        text: "Change Master Password";
                        enabled: root.master-password != "";
                        clicked => {
                            root.show-change-password-dialog = true;
                        }
                    }
                    
                    Button {
                        text: "🔄 Check for Updates";
                        enabled: !root.checking-for-updates;
                        clicked => {
                            root.check-for-updates();
                        }
                    }
                }
            }
        }
        
        GroupBox {
            title: "Password Generator";
            
            VerticalBox {
                spacing: 10px;
                
                HorizontalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "Length:";
                        min-width: 100px;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 8;
                        maximum: 32;
                        value <=> root.generator-length;
                        min-width: 150px;
                    }
                    Text {
                        text: root.generator-length;
                        min-width: 30px;
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    CheckBox {
                        text: "Uppercase (A-Z)";
                        checked <=> root.generator-use-uppercase;
                    }
                    CheckBox {
                        text: "Lowercase (a-z)";
                        checked <=> root.generator-use-lowercase;
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    CheckBox {
                        text: "Digits (0-9)";
                        checked <=> root.generator-use-digits;
                    }
                    CheckBox {
                        text: "Special (!@#$...)";
                        checked <=> root.generator-use-special;
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    CheckBox {
                        text: "Exclude ambiguous (0,O,I,i,l,o,1)";
                        checked <=> root.generator-exclude-ambiguous;
                    }
                }
                
                HorizontalBox {
                    spacing: 5px;
                    
                    generated-password-display := LineEdit {
                        placeholder-text: "Generated password will appear here";
                        read-only: true;
                        text <=> root.generated-password;
                        min-width: 250px;
                    }
                    
                    Button {
                        text: "🔄 Generate";
                        clicked => {
                            root.generate-password();
                        }
                    }
                    
                    Button {
                        text: "📋 Copy";
                        enabled: root.generated-password != "";
                        clicked => {
                            root.copy-password(root.generated-password);
                        }
                    }
                    
                    Button {
                        text: "✓ Use";
                        enabled: root.generated-password != "";
                        clicked => {
                            root.use-generated-password(root.generated-password);
                        }
                    }
                }
                
                if root.password-entropy-text != "" : Text {
                    text: root.password-entropy-text;
                    font-size: 12px;
                    color: #4caf50;
                }
            }
        }
        
        GroupBox {
            title: "Search and Filter Passwords";
            
            VerticalBox {
                spacing: 10px;
                
                HorizontalBox {
                    spacing: 5px;
                    
                    search-input := LineEdit {
                        placeholder-text: "Search by title or username...";
                        text <=> root.search-query;
                        edited => {
                            root.search-passwords(search-input.text);
                        }
                    }
                    
                    Button {
                        text: "🔍 Search";
                        clicked => {
                            root.search-passwords(search-input.text);
                        }
                    }
                    
                    Button {
                        text: "✕ Clear";
                        enabled: search-input.text != "";
                        clicked => {
                            search-input.text = "";
                            root.search-passwords("");
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: 5px;
                    
                    Text {
                        text: "Sort by:";
                        vertical-alignment: center;
                        min-width: 60px;
                    }
                    
                    Button {
                        text: "Title ↑";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(0);
                        }
                    }
                    
                    Button {
                        text: "Title ↓";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(1);
                        }
                    }
                    
                    Button {
                        text: "Newest";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(2);
                        }
                    }
                    
                    Button {
                        text: "Oldest";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(3);
                        }
                    }
                    
                    Button {
                        text: "User";
                        enabled: root.total-count > 0;
                        clicked => {
                            root.sort-passwords(4);
                        }
                    }
                }
                
                if root.total-count > 0 : Text {
                    text: "Showing " + root.filtered-count + " of " + root.total-count + " passwords";
                    font-size: 12px;
                    color: #555;
                }
            }
        }
        
        GroupBox {
            title: "Copy Password to Clipboard";
            
            VerticalBox {
                spacing: 10px;
                
                HorizontalBox {
                    Text {
                        text: "Password to Copy:";
                        vertical-alignment: center;
                        min-width: 120px;
                    }
                    copy-value-input := LineEdit {
                        placeholder-text: "Enter password value to copy";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    Button {
                        text: "📋 Copy to Clipboard";
                        primary: true;
                        enabled: copy-value-input.text != "";
                        clicked => {
                            root.copy-password(copy-value-input.text);
                            // Don't clear the field immediately so user can copy again if needed
                        }
                    }
                    
                    Button {
                        text: "Clear Field";
                        enabled: copy-value-input.text != "";
                        clicked => {
                            copy-value-input.text = "";
                        }
                    }
                }
                
                Text {
                    text: "Password will be automatically cleared from clipboard after 30 seconds";
                    font-size: 12px;
                    color: #666;
                }
            }
        }
        
        GroupBox {
            title: "Stored Passwords";
            
            ScrollView {
                height: 200px;
                
                VerticalBox {
                    Text {
                        text: "Password entries will appear here...";
                        color: #888;
                        font-size: 14px;
                    }
                }
            }
        }
        
        if status-message != "" : HorizontalBox {
            Rectangle {
                background: #e8f5e9;
                border-radius: 4px;
                border-width: 1px;
                border-color: #4caf50;
                
                Text {
                    text: status-message;
                    color: #2e7d32;
                }
            }
        }
    }
    
    // Change Master Password Dialog
    if root.show-change-password-dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        
        Rectangle {
            width: 500px;
            height: 450px;
            background: white;
            border-radius: 8px;
            border-width: 2px;
            border-color: #4caf50;
            
            VerticalBox {
                padding: 20px;
                spacing: 15px;
                
                Text {
                    text: "Change Master Password";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                
                HorizontalBox {
                    Text {
                        text: "Current Password:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    current-password-input := LineEdit {
                        placeholder-text: "Enter current password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "New Password:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    new-password-input := LineEdit {
                        placeholder-text: "Enter new password";
                        input-type: password;
                    }
                }
                
                HorizontalBox {
                    Text {
                        text: "Confirm New:";
                        vertical-alignment: center;
                        min-width: 140px;
                    }
                    confirm-password-input := LineEdit {
                        placeholder-text: "Confirm new password";
                        input-type: password;
                    }
                }
                
                Rectangle {
                    background: #f5f5f5;
                    border-radius: 4px;
                    
                    VerticalBox {
                        padding: 10px;
                        spacing: 5px;
                        
                        Text {
                            text: "Password Requirements:";
                            font-weight: 600;
                            font-size: 14px;
                        }
                        
                        Text {
                            text: "• At least 8 characters long";
                            font-size: 12px;
                            color: #666;
                        }
                        
                        Text {
                            text: "• At least one uppercase letter";
                            font-size: 12px;
                            color: #666;
                        }
                        
                        Text {
                            text: "• At least one lowercase letter";
                            font-size: 12px;
                            color: #666;
                        }
                        
                        Text {
                            text: "• At least one number";
                            font-size: 12px;
                            color: #666;
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    Button {
                        text: "Change Password";
                        primary: true;
                        enabled: current-password-input.text != "" && 
                                new-password-input.text != "" && 
                                confirm-password-input.text != "";
                        clicked => {
                            root.change-master-password(
                                current-password-input.text,
                                new-password-input.text,
                                confirm-password-input.text
                            );
                            // Clear fields and close dialog
                            current-password-input.text = "";
                            new-password-input.text = "";
                            confirm-password-input.text = "";
                            root.show-change-password-dialog = false;
                        }
                    }
                    
                    Button {
                        text: "Cancel";
                        clicked => {
                            // Clear fields and close dialog
                            current-password-input.text = "";
                            new-password-input.text = "";
                            confirm-password-input.text = "";
                            root.show-change-password-dialog = false;
                        }
                    }
                }
            }
        }
    }
    
    // Lock screen overlay
    if root.is-locked : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        Rectangle {
            width: 400px;
            height: 300px;
            background: white;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: 30px;
                spacing: 20px;
                
                Text {
                    text: "🔒 Session Locked";
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Enter master password to unlock";
                    horizontal-alignment: center;
                    color: #666;
                }
                
                unlock-password := LineEdit {
                    placeholder-text: "Master password";
                    input-type: password;
                }
                
                Button {
                    text: "Unlock";
                    primary: true;
                    enabled: unlock-password.text != "";
                    clicked => {
                        root.unlock(unlock-password.text);
                        unlock-password.text = "";
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    
                    TouchArea {
                        width: 150px;
                        height: 20px;
                        
                        Text {
                            text: "Forgot Password?";
                            color: #2196f3;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                        
                        clicked => {
                            root.show-recovery-login = true;
                        }
                    }
                }
            }
        }
    }
    
    // Timer countdown display (when not locked and time is shown)
    if !root.is-locked && root.seconds-until-lock > 0 && root.seconds-until-lock <= 60 : Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 180px;
        height: 30px;
        background: #fff3e0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ff9800;
        
        HorizontalBox {
            padding: 5px;
            
            Text {
                text: "Auto-lock in: " + root.seconds-until-lock + "s";
                color: #e65100;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
    
    // Recovery setup dialog (first-time setup)
    if root.show-recovery-setup : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        Rectangle {
            width: 550px;
            height: 500px;
            background: white;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: 30px;
                spacing: 15px;
                
                Text {
                    text: "⚠️ Important: Save Your Recovery Codes";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Write down these recovery codes and store them securely.\nYou will need them if you forget your master password.";
                    horizontal-alignment: center;
                    color: #666;
                }
                
                Rectangle {
                    background: #f5f5f5;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #ddd;
                    
                    VerticalBox {
                        padding: 20px;
                        spacing: 10px;
                        
                        Text {
                            text: "Recovery Code 1: " + root.recovery-code-1;
                            font-family: "monospace";
                            font-size: 14px;
                        }
                        Text {
                            text: "Recovery Code 2: " + root.recovery-code-2;
                            font-family: "monospace";
                            font-size: 14px;
                        }
                        Text {
                            text: "Recovery Code 3: " + root.recovery-code-3;
                            font-family: "monospace";
                            font-size: 14px;
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    alignment: center;
                    
                    Button {
                        text: "📋 Copy All Codes";
                        clicked => {
                            root.copy-recovery-codes();
                        }
                    }
                    
                    Button {
                        text: "🖨️ Print Codes";
                        clicked => {
                            root.print-recovery-codes();
                        }
                    }
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    CheckBox {
                        text: "I have saved my recovery codes in a secure location";
                        checked <=> root.recovery-codes-confirmed;
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    
                    Button {
                        text: "Continue";
                        enabled: root.recovery-codes-confirmed;
                        primary: true;
                        clicked => {
                            root.show-recovery-setup = false;
                            root.recovery-codes-confirmed = false;
                        }
                    }
                }
            }
        }
    }
    
    // Recovery login dialog
    if root.show-recovery-login : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        
        Rectangle {
            width: 450px;
            height: 350px;
            background: white;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ff9800;
            
            VerticalBox {
                padding: 30px;
                spacing: 20px;
                
                Text {
                    text: "🔑 Emergency Recovery";
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Enter one of your recovery codes to regain access:";
                    horizontal-alignment: center;
                    color: #666;
                }
                
                recovery-code-input := LineEdit {
                    placeholder-text: "XXXX-XXXX-XXXX-XXXX";
                }
                
                HorizontalBox {
                    spacing: 10px;
                    alignment: center;
                    
                    Button {
                        text: "Recover Access";
                        primary: true;
                        enabled: recovery-code-input.text != "";
                        clicked => {
                            root.recover-with-code(recovery-code-input.text);
                            recovery-code-input.text = "";
                        }
                    }
                    
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.show-recovery-login = false;
                            recovery-code-input.text = "";
                        }
                    }
                }
                
                Text {
                    text: "⚠️ Recovery codes were provided during initial setup.\nContact support if you've lost all recovery codes.";
                    horizontal-alignment: center;
                    font-size: 11px;
                    color: #999;
                }
            }
        }
    }
}
